# Copia este archivo: cp .env.example .env.local
# Ajusta valores según tu MySQL local (MAMP suele usar puerto 8889).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_usuarios

# Opcional: ID de operador para auditoría (created_at_user_id / updated_at_user_id).
# Si no se define, al crear un usuario se usa su propio id.
# ACTOR_USER_ID=1
